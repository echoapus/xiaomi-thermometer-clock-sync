# Install: see README "Run on a schedule". Adjust User= and paths to your setup.
[Unit]
Description=Sync Xiaomi LYWSD02 clock over BLE
Wants=bluetooth.target
After=bluetooth.target time-sync.target

[Service]
Type=oneshot
User=pi
EnvironmentFile=/etc/default/xiaomi-thermometer-clock-sync
ExecStart=/opt/xiaomi-thermometer-clock-sync/.venv/bin/xiaomi-thermometer-clock-sync
TimeoutStartSec=5min
